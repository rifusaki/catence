# Shared local catalog; defaults to ~/.catence when unset.
# For isolated development, point it at a checkout-local directory:
#   export CATENCE_HOME="$PWD/.catence-dev"
# See docs/development.md for the from-source and Docker dev loops.
CATENCE_HOME=

# Provider credentials — preferred: per-athlete files via stdin (see below).
# `catence-data --athlete <id> secret set --value-stdin` writes to
# $CATENCE_HOME/athletes/<id>/secrets/providers.json (mode 0600). File values
# win. For local/Docker dev you may instead keep credentials in env:
#   1) Per-athlete scoped (always allowed, multi-athlete safe):
#        CATENCE_ATHLETE_ALEX_GARMIN_EMAIL, CATENCE_ATHLETE_ALEX_GARMIN_PASSWORD, ...
#      Prefix is CATENCE_ATHLETE_<ID>_ where <ID> is the athlete id upper-cased
#      with hyphens → underscores (e.g. athlete "alex" → CATENCE_ATHLETE_ALEX_).
#   2) Generic (opt-in, single-athlete dev only):
#        CATENCE_ALLOW_ENV_SECRETS=1  +  GARMIN_EMAIL, INTERVALS_API_KEY, ...
#      Without the flag, bare GARMIN_*/INTERVALS_*/STRAVA_* are ignored to avoid
#      leaking a shared process's env into the wrong athlete. See
#      docs/configuration.md and docs/development.md.

# Required only when running the password-protected Console.
CATENCE_CONSOLE_USERNAME=
CATENCE_CONSOLE_PASSWORD_HASH='' # (with single quotes, from `catence-console auth hash-password`)
CHAINLIT_AUTH_SECRET=

# Optional: allow generic provider env vars as a fallback when a
# per-athlete providers.json field is missing. Prefer per-athlete scoped vars
# above for multi-athlete catalogs. Set to 1/true/yes/on to enable.
# CATENCE_ALLOW_ENV_SECRETS=1
# Generic fallback (only when the flag above is set):
# GARMIN_EMAIL=
# GARMIN_PASSWORD=
# INTERVALS_API_KEY=
# INTERVALS_ATHLETE_ID=
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# Per-athlete scoped fallback (no flag needed, works always):
# CATENCE_ATHLETE_ALEX_GARMIN_EMAIL=
# CATENCE_ATHLETE_ALEX_GARMIN_PASSWORD=
# CATENCE_ATHLETE_ALEX_INTERVALS_API_KEY=
# CATENCE_ATHLETE_ALEX_INTERVALS_ATHLETE_ID=
# CATENCE_ATHLETE_ALEX_STRAVA_CLIENT_ID=
# CATENCE_ATHLETE_ALEX_STRAVA_CLIENT_SECRET=

# Console model provider — one profile's env vars (values are process-only and
# are never persisted in config.json). The profile's config.json entry names
# the *env var* (apiKeyEnv / apiBaseEnv / apiVersionEnv), not the value.
# OPENAI_API_BASE points the "openai-compatible" profile at any OpenAI-compatible
# endpoint (Azure, Opencode, proxies). See docs/llm-providers.md and
# docs/configuration.md. config.example.json is the canonical profile template.
OPENAI_API_KEY=
OPENAI_API_BASE=
ANTHROPIC_API_KEY=
# OpenCode (any non-empty value passes the required-env check for free models):
# OPENCODE_API_KEY=
# OPENCODE_GO_API_KEY=
# OPENCODE_GO_API_BASE=https://opencode.ai/zen/go/v1
# OPENCODE_GO_MESSAGES_API_BASE=https://opencode.ai/zen/go
# OPENCODE_ZEN_API_BASE=https://opencode.ai/zen/v1
# OPENCODE_ZEN_RESPONSES_API_BASE=https://opencode.ai/zen/v1
