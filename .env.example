# Shared local catalog; defaults to ~/.catence when unset.
CATENCE_HOME=

# Add Garmin, Intervals.icu, and Strava client values per athlete with
# `catence-data --athlete <id> secret set --value-stdin`. Do not put them here.

# Required only when running the password-protected Console.
CATENCE_CONSOLE_USERNAME=
CATENCE_CONSOLE_PASSWORD_HASH='' # (with single quotes)
CHAINLIT_AUTH_SECRET=

# One Console model provider (values are process-only and are never persisted).
# OPENAI_API_BASE points the "openai-compatible" profile at any OpenAI-compatible
# endpoint (Azure, Opencode, proxies). See docs/llm-providers.md.
OPENAI_API_KEY=
OPENAI_API_BASE=
ANTHROPIC_API_KEY=
