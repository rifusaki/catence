# Copy to .env.beta on the beta server. It is intentionally ignored by Git.
CATENCE_NPM_VERSION=0.2.0-beta.20
# catence-console may lag npm on the beta channel; keep this pinned to the
# newest version actually published on PyPI.
CATENCE_CONSOLE_VERSION=0.2.0b19
CATENCE_CONSOLE_PORT=8000

CATENCE_CONSOLE_USERNAME=coach
# Generate with: catence-console auth hash-password (with single quotes)
CATENCE_CONSOLE_PASSWORD_HASH=''
# Generate with: openssl rand -hex 32
CHAINLIT_AUTH_SECRET=

# Configure the provider used by the Console wizard or config.json.
# OPENAI_API_BASE points the "openai-compatible" profile at an OpenAI-compatible
# endpoint (Azure, Opencode, proxies). See docs/llm-providers.md.
OPENAI_API_KEY=
OPENAI_API_BASE=
ANTHROPIC_API_KEY=

# Tailscale
CATENCE_MCP_BIND=0.0.0.0